dependencies/
build/
dist/
*.egg-info/
*.zip

# Virtual environments
.venv/
venv/
env/

# Credentials — integration test suites read these
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
